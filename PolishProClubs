<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Esports League</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #121212;
            color: #ffffff;
            margin: 0;
            padding: 0;
        }
        header {
            background-color: #1f1f1f;
            padding: 20px;
            text-align: center;
        }
        header h1 {
            color: #00ffcc;
        }
        nav {
            display: flex;
            justify-content: center;
            gap: 15px;
            background-color: #00ffcc;
            padding: 10px 0;
        }
        nav a {
            color: #121212;
            text-decoration: none;
            font-weight: bold;
        }
        .container {
            padding: 20px;
            max-width: 1200px;
            margin: 0 auto;
        }
        .leaderboard, .calendar {
            background-color: #1e1e1e;
            border: 1px solid #444;
            border-radius: 5px;
            padding: 20px;
            margin-bottom: 20px;
        }
        .leaderboard h2, .calendar h2 {
            color: #00ffcc;
        }
        .leaderboard ul, .calendar ul {
            list-style: none;
            padding: 0;
        }
        .leaderboard li, .calendar li {
            padding: 10px 0;
            border-bottom: 1px solid #444;
        }
        .leaderboard li:last-child, .calendar li:last-child {
            border-bottom: none;
        }
        footer {
            text-align: center;
            padding: 10px;
            background-color: #1f1f1f;
            color: #fff;
            position: relative;
            bottom: 0;
            width: 100%;
        }
    </style>
</head>
<body>
    <header>
        <h1>Esports League</h1>
    </header>
    <nav>
        <a href="#">Home</a>
        <a href="#leaderboard">Leaderboard</a>
        <a href="#schedule">Schedule</a>
        <a href="#login">Login</a>
    </nav>
    <div class="container">
        <section id="leaderboard" class="leaderboard">
            <h2>League Table</h2>
            <ul>
                <li>Team A - 30 pts</li>
                <li>Team B - 28 pts</li>
                <li>Team C - 26 pts</li>
            </ul>
        </section>

        <section id="schedule" class="calendar">
            <h2>Upcoming Matches</h2>
            <ul>
                <li>Team A vs Team B - Jan 10, 2025</li>
                <li>Team C vs Team D - Jan 12, 2025</li>
                <li>Team E vs Team F - Jan 15, 2025</li>
            </ul>
        </section>

        <section id="login" class="login">
            <h2>Login</h2>
            <form action="/submit" method="post">
                <label for="username">Username:</label><br>
                <input type="text" id="username" name="username" required><br><br>
                <label for="password">Password:</label><br>
                <input type="password" id="password" name="password" required><br><br>
                <button type="submit">Login</button>
            </form>
        </section>
    </div>
    <footer>
        <p>&copy; 2025 Esports League. All Rights Reserved.</p>
    </footer>
</body>
</html>
